# Supabase project settings (Dashboard → Connect, or Project Settings → API Keys)
# Use the PUBLISHABLE key (sb_publishable_...) or legacy anon key. Never the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Port for the Express server
PORT=3000

# Test user for scripts/get-token.js (create it in Dashboard → Authentication → Users)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=choose-a-password
